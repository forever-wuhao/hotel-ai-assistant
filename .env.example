# Reference only: Spring Boot does not automatically load this file.
# Default: demo data + scripted offline model, no external credentials.
SPRING_PROFILES_ACTIVE=demo
HOTEL_AI_MODE=demo
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9090

# Live model, using your own credentials (also usable with the demo data profile).
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas
ZHIPU_CHAT_MODEL=glm-4.7
ZHIPU_EMBEDDING_MODEL=embedding-3
AMAP_WEB_SERVICE_KEY=

# Required when using SPRING_PROFILES_ACTIVE=live.
DATABASE_URL=jdbc:mysql://localhost:3306/yisu_hotel?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DATABASE_USER=
DATABASE_PASSWORD=
KNOWLEDGE_MANIFEST=
KNOWLEDGE_CACHE=runtime/knowledge
